// Cloudflare Workers (სტატიკური საიტი): `npm run deploy` ააშენებს და ატვირთავს
{
  "name": "skyresort",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./dist/skyresort",
    // Angular-ის მისამართები (/place, /resort/gudauri ...) პირდაპირ გახსნისას და F5-ზე index.html-ს ხსნის
    "not_found_handling": "single-page-application"
  }
}
